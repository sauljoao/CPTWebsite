<% content_for :title, "CPT Consulting - Premium websites for growing businesses" %>

<section class="cpt-section-dark relative overflow-hidden">
  <div class="cpt-container relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <%= render Ui::BadgeComponent.new(text: "Strategy, design, and Rails delivery") %>
      <h1 class="mt-8 text-4xl font-semibold text-white sm:text-6xl">Premium websites built with business clarity.</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-purple-100">CPT Consulting designs and builds polished, fast, maintainable websites for businesses that need trust at first glance and a system that can grow.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <%= render Ui::ButtonComponent.new(label: "Get an estimate", href: new_quote_request_path, variant: :light) %>
        <%= render Ui::ButtonComponent.new(label: "View products", href: products_path, variant: :ghost, class: "text-white hover:bg-white/10") %>
      </div>
    </div>
    <%= render Marketing::ProductMockupComponent.new %>
  </div>
</section>

<%= render Marketing::SectionComponent.new(eyebrow: "Products", title: "Clear packages for common business needs", subtitle: "Start with a focused product, then shape the details around your goals.") do %>
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    <% @products.each do |product| %>
      <%= render Ui::CardComponent.new(classes: "flex h-full flex-col") do %>
        <h3 class="text-lg font-semibold"><%= product.name %></h3>
        <p class="cpt-body mt-3 flex-1 text-sm leading-6"><%= product.description %></p>
        <p class="mt-6 text-sm font-semibold text-[#18111f]"><%= product.starting_price %></p>
        <%= link_to "Explore", product_path(product), class: "cpt-link mt-4" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="cpt-section cpt-section-muted">
  <div class="cpt-container">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="cpt-eyebrow">Why CPT</p>
        <h2 class="cpt-heading mt-3 text-3xl sm:text-4xl">A premium website should be beautiful, useful, and easy to own.</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <% [["Business first", "Every page is tied to conversion, credibility, or operational clarity."], ["Server-side first", "Rails, Turbo, and simple interactions keep the experience fast and maintainable."], ["Reusable by default", "Components and content structures are built once and improved with each project."], ["Launch discipline", "Accessibility, performance, and responsive QA are part of the process."]].each do |title, body| %>
          <div class="cpt-card">
            <h3 class="font-semibold"><%= title %></h3>
            <p class="cpt-body mt-2 text-sm leading-6"><%= body %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render Marketing::SectionComponent.new(eyebrow: "Process", title: "A calm process from idea to launch", subtitle: "Small, visible steps reduce uncertainty and keep momentum high.") do %>
  <div class="grid gap-5 md:grid-cols-4">
    <% [["01", "Discover", "Clarify offer, audience, content, and success metrics."], ["02", "Design", "Shape the visual system and core page patterns."], ["03", "Build", "Develop with Rails conventions, reusable components, and focused content."], ["04", "Launch", "QA, deploy, measure, and prepare the next improvement cycle."]].each do |number, title, body| %>
      <div class="border-t border-[#e8dfef] pt-5">
        <p class="text-sm font-semibold text-[#f97316]"><%= number %></p>
        <h3 class="mt-3 font-semibold"><%= title %></h3>
        <p class="cpt-body mt-2 text-sm leading-6"><%= body %></p>
      </div>
    <% end %>
  </div>
<% end %>

<section class="cpt-section-dark py-20 sm:py-24">
  <div class="cpt-container">
    <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
      <div>
        <p class="cpt-eyebrow-light">Pricing</p>
        <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Transparent starting points.</h2>
        <p class="mt-4 max-w-2xl text-purple-100">Each package has a clear base price. Your final proposal depends on scope, content, integrations, and timeline.</p>
      </div>
      <%= render Ui::ButtonComponent.new(label: "See pricing", href: pricing_path, variant: :light) %>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-4">
      <% @products.each_with_index do |product, index| %>
        <%= render Marketing::PricingCardComponent.new(product: product, highlighted: index == 1) %>
      <% end %>
    </div>
  </div>
</section>

<%= render Marketing::SectionComponent.new(eyebrow: "Portfolio", title: "Built to showcase real client work", subtitle: "The first projects are placeholders, structured so case studies can become richer over time.") do %>
  <div class="grid gap-5 md:grid-cols-3">
    <% @portfolio_projects.each do |project| %>
      <%= render Ui::CardComponent.new do %>
        <p class="text-sm font-medium text-[#7c3aed]"><%= project.industry %></p>
        <h3 class="mt-3 text-xl font-semibold"><%= project.title %></h3>
        <p class="cpt-body mt-3 text-sm leading-6"><%= project.summary %></p>
        <%= link_to "View project", portfolio_project_path(project), class: "cpt-link mt-6 inline-flex" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="cpt-section cpt-section-muted">
  <div class="cpt-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="cpt-eyebrow">FAQ</p>
      <h2 class="cpt-heading mt-3 text-3xl">Questions before we start?</h2>
      <p class="cpt-body mt-4">A few practical answers. The full FAQ covers scope, timelines, ownership, and support.</p>
      <%= render Ui::ButtonComponent.new(label: "Read FAQ", href: faq_path, variant: :secondary, class: "mt-8") %>
    </div>
    <div class="cpt-card px-6">
      <% @faqs.each do |faq| %>
        <%= render Marketing::FaqItemComponent.new(faq: faq) %>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/contact_cta" %>
