<% content_for :title, "#{@product.name} - CPT Consulting" %>

<section class="cpt-section">
  <div class="cpt-container grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <p class="cpt-eyebrow">Produto</p>
      <h1 class="cpt-heading mt-3 text-4xl sm:text-5xl"><%= @product.name %></h1>
      <p class="cpt-body mt-6 text-lg leading-8"><%= @product.description %></p>
      <p class="mt-8 text-3xl font-semibold"><%= @product.starting_price %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= render Ui::ButtonComponent.new(label: @product.cta_label, href: new_quote_request_path(product_id: @product.id)) %>
        <%= render Ui::ButtonComponent.new(label: "Falar connosco", href: contact_path, variant: :secondary) %>
      </div>
    </div>
    <%= render ::Sections::ProductMockupComponent.new(product: @product) %>
  </div>
</section>

<section class="cpt-section cpt-section-muted">
  <div class="cpt-container">
    <%= render Ui::CardComponent.new do %>
      <h2 class="text-xl font-semibold">Incluído</h2>
      <ul class="cpt-body mt-6 grid gap-4 sm:grid-cols-2">
        <% @product.features.each do |feature| %>
          <li class="flex gap-3"><span class="cpt-check">✓</span><%= feature %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
