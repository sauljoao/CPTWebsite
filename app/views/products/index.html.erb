<% content_for :title, "Products - CPT Consulting" %>

<%= render Marketing::SectionComponent.new(eyebrow: "Products", title: "Four focused ways to build", subtitle: "Choose the product that matches the stage and ambition of your business.") do %>
  <div class="grid gap-8">
    <% @products.each do |product| %>
      <%= render Ui::CardComponent.new(classes: "grid gap-8 lg:grid-cols-[0.85fr_1.15fr]") do %>
        <div>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-2xl font-semibold"><%= product.name %></h2>
              <p class="cpt-body mt-3"><%= product.description %></p>
            </div>
            <p class="shrink-0 text-lg font-semibold text-[#18111f]"><%= product.starting_price %></p>
          </div>
          <ul class="cpt-body mt-6 grid gap-2 text-sm">
            <% product.features.each do |feature| %>
              <li><span class="cpt-check">✓</span> <%= feature %></li>
            <% end %>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <%= render Ui::ButtonComponent.new(label: product.cta_label, href: new_quote_request_path(product_id: product.id)) %>
            <%= render Ui::ButtonComponent.new(label: "Details", href: product_path(product), variant: :secondary) %>
          </div>
        </div>
        <%= render Marketing::ProductMockupComponent.new(product: product) %>
      <% end %>
    <% end %>
  </div>
<% end %>
