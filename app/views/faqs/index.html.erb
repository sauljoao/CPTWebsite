<% content_for :title, "FAQ - CPT Consulting" %>

<%= render ::Sections::SectionComponent.new(eyebrow: "FAQ", title: "Respostas práticas antes de começarmos", subtitle: "Âmbito, processo, propriedade e suporte em linguagem simples.") do %>
  <div class="cpt-card mx-auto max-w-3xl px-6">
    <% @faqs.each do |category, faqs| %>
      <div class="py-6">
        <h2 class="cpt-eyebrow"><%= category %></h2>
        <% faqs.each do |faq| %>
          <%= render ::Sections::FaqItemComponent.new(faq: faq) %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
