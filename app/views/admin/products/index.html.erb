<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold">Products</h1>
  <%= render Ui::ButtonComponent.new(label: "New product", href: new_admin_product_path) %>
</div>
<div class="mt-6 overflow-hidden rounded-lg border border-[#e8dfef] bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-[#fff8df] cpt-body">
      <tr><th class="p-4">Name</th><th class="p-4">Price</th><th class="p-4">Published</th><th class="p-4"></th></tr>
    </thead>
    <tbody class="divide-y divide-[#e8dfef]">
      <% @products.each do |product| %>
        <tr>
          <td class="p-4 font-medium"><%= product.name %></td>
          <td class="p-4"><%= number_to_currency(product.price, precision: 0) %></td>
          <td class="p-4"><%= product.published? ? "Yes" : "No" %></td>
          <td class="p-4 text-right"><%= link_to "Edit", edit_admin_product_path(product), class: "cpt-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
