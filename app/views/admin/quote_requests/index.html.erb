<h1 class="text-2xl font-semibold">Quote Requests</h1>
<div class="mt-6 overflow-hidden rounded-lg border border-[#e8dfef] bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-[#fff8df] cpt-body">
      <tr><th class="p-4">Name</th><th class="p-4">Product</th><th class="p-4">Estimate</th><th class="p-4">Status</th><th class="p-4"></th></tr>
    </thead>
    <tbody class="divide-y divide-[#e8dfef]">
      <% @quote_requests.each do |request| %>
        <tr>
          <td class="p-4 font-medium"><%= request.name %></td>
          <td class="p-4"><%= request.product&.name || "Custom" %></td>
          <td class="p-4"><%= number_to_currency(request.estimated_price_cents / 100, precision: 0) %></td>
          <td class="p-4"><%= request.status.titleize %></td>
          <td class="p-4 text-right"><%= link_to "Open", admin_quote_request_path(request), class: "cpt-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
