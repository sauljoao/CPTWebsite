  <%= render Ui::ButtonComponent.new(label: "Edit", href: edit_admin_portfolio_project_path(@portfolio_project), variant: :secondary) %>
</div>
<div class="mt-6 cpt-card">
  <p class="cpt-link"><%= @portfolio_project.industry %></p>
