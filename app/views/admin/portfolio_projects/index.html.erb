<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold">Portfolio</h1>
  <%= render Ui::ButtonComponent.new(label: "New project", href: new_admin_portfolio_project_path) %>
</div>
<div class="mt-6 grid gap-4">
  <% @portfolio_projects.each do |project| %>
    <div class="cpt-card">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="font-semibold"><%= project.title %></h2>
          <p class="mt-1 text-sm cpt-body"><%= project.product_type %> · <%= project.industry %> · <%= project.published? ? "Published" : "Draft" %></p>
        </div>
        <%= link_to "Edit", edit_admin_portfolio_project_path(project), class: "cpt-link" %>
      </div>
    </div>
  <% end %>
</div>
