<section class="cpt-section">
  <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
    <h2 class="cpt-heading text-3xl sm:text-4xl">Ready to make your website feel as good as your business?</h2>
    <p class="cpt-body mx-auto mt-4 max-w-2xl">Tell us what you are building. We will reply with a practical next step, not a bloated process.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <%= render Ui::ButtonComponent.new(label: "Request a quote", href: new_quote_request_path) %>
      <%= render Ui::ButtonComponent.new(label: "Request a meeting", href: contact_path(request_type: "meeting"), variant: :secondary) %>
    </div>
  </div>
</section>
