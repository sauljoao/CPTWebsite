<section class="cpt-section">
  <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
    <h2 class="cpt-heading text-3xl sm:text-4xl">Pronto para ter um website à altura do seu negócio?</h2>
    <p class="cpt-body mx-auto mt-4 max-w-2xl">Diga-nos o que está a construir. Respondemos com um próximo passo prático, sem processo pesado.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <%= render Ui::ButtonComponent.new(label: "Pedir orçamento", href: new_quote_request_path) %>
      <%= render Ui::ButtonComponent.new(label: "Pedir reunião", href: contact_path(request_type: "meeting"), variant: :secondary) %>
    </div>
  </div>
</section>
