<% content_for :title, "Preços - CPT Consulting" %>

<%= render ::Sections::SectionComponent.new(eyebrow: "Preços", title: "Preços transparentes, ajustados ao âmbito", subtitle: "Cada produto tem um preço base e uma lista clara de inclusões. Use a calculadora para uma estimativa rápida.") do %>
  <div class="grid gap-6 lg:grid-cols-4">
    <% @products.each_with_index do |product, index| %>
      <%= render ::Sections::PricingCardComponent.new(product: product, highlighted: index == 1) %>
    <% end %>
  </div>
  <div class="cpt-card-soft mt-12 text-center">
    <h2 class="text-2xl font-semibold">Estime o seu projecto</h2>
    <p class="cpt-body mx-auto mt-3 max-w-2xl">Responda a algumas perguntas de âmbito e receba uma estimativa prática antes da proposta final.</p>
    <%= render Ui::ButtonComponent.new(label: "Abrir calculadora", href: new_quote_request_path, class: "mt-6") %>
  </div>
  <div class="mt-12 grid gap-8">
    <% @products.each do |product| %>
      <%= render ::Sections::ProductMockupComponent.new(product: product) %>
    <% end %>
  </div>
<% end %>
