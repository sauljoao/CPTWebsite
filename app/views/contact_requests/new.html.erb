<% content_for :title, "Contact - CPT Consulting" %>

<section class="cpt-section">
  <div class="cpt-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="cpt-eyebrow">Contact</p>
      <h1 class="cpt-heading mt-3 text-4xl sm:text-5xl">Tell us what you are building.</h1>
      <p class="cpt-body mt-6 text-lg leading-8">Send a message, request a quote, or ask for a meeting. We will reply with the cleanest next step.</p>
    </div>
    <%= render Ui::CardComponent.new do %>
      <%= form_with model: @contact_request, url: contact_requests_path, class: "grid gap-5" do |form| %>
        <%= render "shared/form_errors", object: @contact_request %>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :name, class: "text-sm font-medium" %>
            <%= form.text_field :name, class: "cpt-field" %>
          </div>
          <div>
            <%= form.label :email, class: "text-sm font-medium" %>
            <%= form.email_field :email, class: "cpt-field" %>
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :company, class: "text-sm font-medium" %>
            <%= form.text_field :company, class: "cpt-field" %>
          </div>
          <div>
            <%= form.label :request_type, "Request type", class: "text-sm font-medium" %>
            <%= form.select :request_type, ContactRequest::REQUEST_TYPES.map { |type| [type.titleize, type] }, {}, class: "cpt-field" %>
          </div>
        </div>
        <div>
          <%= form.label :message, class: "text-sm font-medium" %>
          <%= form.text_area :message, rows: 6, class: "cpt-field" %>
        </div>
        <%= render Ui::ButtonComponent.new(label: "Send request", type: "submit") %>
      <% end %>
    <% end %>
  </div>
</section>
