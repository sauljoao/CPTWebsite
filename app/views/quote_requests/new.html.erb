<% content_for :title, "Calculadora de orçamento - CPT Consulting" %>

<section class="cpt-section" data-controller="quote-calculator">
  <div class="cpt-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="cpt-eyebrow">Calculadora de orçamento</p>
      <h1 class="cpt-heading mt-3 text-4xl sm:text-5xl">Obtenha uma estimativa prática.</h1>
      <p class="cpt-body mt-6 text-lg leading-8">Configure o âmbito principal. O pedido guardado dá à CPT contexto suficiente para preparar uma proposta precisa.</p>
      <div class="cpt-card-dark mt-8">
        <p class="text-sm text-purple-100">Investimento estimado</p>
        <p class="mt-2 text-4xl font-semibold" data-quote-calculator-target="estimate">$0</p>
      </div>
    </div>
    <%= render Ui::CardComponent.new do %>
      <%= form_with model: @quote_request, url: quote_requests_path, id: "quote-form", class: "grid gap-5" do |form| %>
        <%= render "shared/form_errors", object: @quote_request %>
        <div>
          <%= form.label :product_id, "Produto", class: "text-sm font-medium" %>
          <%= form.select :product_id, @products.map { |product| [product.name, product.id, { data: { price: product.price } }] }, {}, class: "cpt-field", data: { quote_calculator_target: "product", action: "quote-calculator#update" } %>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :pages, "Número aproximado de páginas", class: "text-sm font-medium" %>
            <%= form.number_field :pages, value: 5, min: 1, max: 40, class: "cpt-field", data: { quote_calculator_target: "pages", action: "input->quote-calculator#update" } %>
          </div>
          <div>
            <%= form.label :complexity, "Complexidade", class: "text-sm font-medium" %>
            <%= form.select :complexity, [["Simples", "simple", { data: { multiplier: 1 } }], ["Standard", "standard", { data: { multiplier: 1.25 } }], ["Avançado", "advanced", { data: { multiplier: 1.6 } }]], {}, class: "cpt-field", data: { quote_calculator_target: "complexity", action: "quote-calculator#update" } %>
          </div>
        </div>
        <fieldset>
          <legend class="text-sm font-medium">Extras</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <% QuoteCalculator::ADD_ONS.each do |key, price| %>
              <label class="cpt-choice">
                <%= check_box_tag "quote_request[add_ons][]", key, false, id: "quote_request_add_on_#{key}", data: { quote_calculator_target: "addOn", action: "quote-calculator#update", price: price } %>
                <span><%= { "copywriting" => "Copywriting", "brand_refresh" => "Ajuste de marca", "cms_setup" => "Configuração CMS", "analytics" => "Analytics", "priority_delivery" => "Entrega prioritária" }.fetch(key) %> <span class="text-[#655d6f]">+<%= number_to_currency(price, precision: 0) %></span></span>
              </label>
            <% end %>
          </div>
        </fieldset>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :name, "Nome", class: "text-sm font-medium" %>
            <%= form.text_field :name, class: "cpt-field" %>
          </div>
          <div>
            <%= form.label :email, class: "text-sm font-medium" %>
            <%= form.email_field :email, class: "cpt-field" %>
          </div>
        </div>
        <div>
          <%= form.label :company, "Empresa", class: "text-sm font-medium" %>
          <%= form.text_field :company, class: "cpt-field" %>
        </div>
        <div>
          <%= form.label :message, "Notas do projecto", class: "text-sm font-medium" %>
          <%= form.text_area :message, rows: 4, class: "cpt-field" %>
        </div>
        <%= render Ui::ButtonComponent.new(label: "Pedir orçamento", type: "submit") %>
      <% end %>
    <% end %>
  </div>
</section>
