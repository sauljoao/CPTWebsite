<% content_for :title, "Portefólio - CPT Consulting" %>

<%= render ::Sections::SectionComponent.new(eyebrow: "Portefólio", title: "Três exemplos para cada tipo de produto", subtitle: "Exemplos interactivos que mostram como cada produto CPT pode servir diferentes negócios.") do %>
  <div class="grid gap-12">
    <% @portfolio_projects.group_by(&:product_type).each do |product_type, projects| %>
      <section>
        <div class="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <p class="cpt-eyebrow"><%= product_type %></p>
            <h2 class="cpt-heading mt-2 text-2xl"><%= projects.size %> exemplos</h2>
          </div>
          <%= link_to "Estimar #{product_type.downcase}", new_quote_request_path, class: "cpt-link" %>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          <% projects.each do |project| %>
            <%= render ::Sections::PortfolioCardComponent.new(project: project) %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
