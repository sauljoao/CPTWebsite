<section class="cpt-section-dark relative overflow-hidden">
  <div class="cpt-container relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <%= render Ui::BadgeComponent.new(text: "Estratégia, design e desenvolvimento Rails") %>
      <h1 class="mt-8 text-4xl font-semibold text-white sm:text-6xl">Websites premium construídos com clareza de negócio.</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-purple-100">A CPT Consulting cria websites rápidos, elegantes e fáceis de manter para empresas que precisam de gerar confiança desde o primeiro contacto.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <%= render Ui::ButtonComponent.new(label: "Obter estimativa", href: new_quote_request_path, variant: :light) %>
        <%= render Ui::ButtonComponent.new(label: "Ver produtos", href: products_path, variant: :ghost, class: "text-white hover:bg-white/10") %>
      </div>

</section>

<%= render ::Sections::SectionComponent.new(eyebrow: "Produtos", title: "Pacotes claros para necessidades reais", subtitle: "Comece com um produto focado e ajuste o detalhe ao objectivo do projecto.") do %>
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    <% @products.each do |product| %>
      <%= render Ui::CardComponent.new(classes: "flex h-full flex-col") do %>
        <h3 class="text-lg font-semibold"><%= product.name %></h3>
        <p class="cpt-body mt-3 flex-1 text-sm leading-6"><%= product.description %></p>
        <p class="mt-6 text-sm font-semibold text-[#18111f]"><%= product.starting_price %></p>
        <%= link_to "Explorar", product_path(product), class: "cpt-link mt-4" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="cpt-section cpt-section-muted">
  <div class="cpt-container">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="cpt-eyebrow">Porquê a CPT</p>
        <h2 class="cpt-heading mt-3 text-3xl sm:text-4xl">Um website premium deve ser bonito, útil e simples de gerir.</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <% [["Negócio primeiro", "Cada página apoia conversão, credibilidade ou clareza operacional."], ["Rails primeiro", "Rails, Turbo e interacções simples mantêm a experiência rápida e sustentável."], ["Reutilização natural", "Componentes e estruturas são criados no contexto real de cada projecto."], ["Lançamento cuidado", "Acessibilidade, performance e revisão responsiva fazem parte do processo."]].each do |title, body| %>
          <div class="cpt-card">
            <h3 class="font-semibold"><%= title %></h3>
            <p class="cpt-body mt-2 text-sm leading-6"><%= body %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render ::Sections::SectionComponent.new(eyebrow: "Processo", title: "Um percurso calmo da ideia ao lançamento", subtitle: "Passos pequenos e visíveis reduzem incerteza e mantêm o projecto em movimento.") do %>
  <div class="grid gap-5 md:grid-cols-4">
    <% [["01", "Descobrir", "Clarificar oferta, público, conteúdo e métricas."], ["02", "Desenhar", "Definir sistema visual e padrões de página."], ["03", "Construir", "Desenvolver com convenções Rails e componentes reutilizáveis."], ["04", "Lançar", "Validar, publicar, medir e preparar a próxima melhoria."]].each do |number, title, body| %>
      <div class="border-t border-[#e8dfef] pt-5">
        <p class="text-sm font-semibold text-[#f97316]"><%= number %></p>
        <h3 class="mt-3 font-semibold"><%= title %></h3>
        <p class="cpt-body mt-2 text-sm leading-6"><%= body %></p>
      </div>
    <% end %>
  </div>
<% end %>

<section class="cpt-section-dark py-20 sm:py-24">
  <div class="cpt-container">
    <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
      <div>
        <p class="cpt-eyebrow-light">Preços</p>
        <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Pontos de partida transparentes.</h2>
        <p class="mt-4 max-w-2xl text-purple-100">Cada pacote tem um preço base claro. A proposta final depende de âmbito, conteúdo, integrações e prazo.</p>
      </div>
      <%= render Ui::ButtonComponent.new(label: "Ver preços", href: pricing_path, variant: :light) %>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-4">
      <% @products.each_with_index do |product, index| %>
        <%= render ::Sections::PricingCardComponent.new(product: product, highlighted: index == 1) %>
      <% end %>
    </div>
  </div>
</section>

<%= render ::Sections::SectionComponent.new(eyebrow: "Portefólio", title: "Exemplos preparados para trabalho real", subtitle: "Projectos de exemplo estruturados para evoluírem para estudos de caso reais.") do %>
  <div class="grid gap-5 md:grid-cols-3">
    <% @portfolio_projects.each do |project| %>
      <%= render Ui::CardComponent.new do %>
        <p class="text-sm font-medium text-[#7c3aed]"><%= project.industry %></p>
        <h3 class="mt-3 text-xl font-semibold"><%= project.title %></h3>
        <p class="cpt-body mt-3 text-sm leading-6"><%= project.summary %></p>
        <%= link_to "Ver projecto", portfolio_project_path(project), class: "cpt-link mt-6 inline-flex" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<section class="cpt-section cpt-section-muted">
  <div class="cpt-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="cpt-eyebrow">FAQ</p>
      <h2 class="cpt-heading mt-3 text-3xl">Perguntas antes de começar?</h2>
      <p class="cpt-body mt-4">Algumas respostas práticas sobre âmbito, prazos, propriedade e suporte.</p>
      <%= render Ui::ButtonComponent.new(label: "Ler FAQ", href: faq_path, variant: :secondary, class: "mt-8") %>
    </div>
    <div class="cpt-card px-6">
      <% @faqs.each do |faq| %>
        <%= render ::Sections::FaqItemComponent.new(faq: faq) %>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/contact_cta" %>
