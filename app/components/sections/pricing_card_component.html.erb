<article class="<%= @highlighted ? "cpt-card-dark" : "cpt-card" %>">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold"><%= @product.name %></h3>
      <p class="<%= @highlighted ? "mt-2 text-sm leading-6 text-purple-100" : "cpt-body mt-2 text-sm leading-6" %>"><%= @product.description %></p>
    </div>
    <% if @highlighted %>
      <%= render Ui::BadgeComponent.new(text: "Popular") %>
    <% end %>
  </div>
  <p class="mt-6 text-3xl font-semibold"><%= number_to_currency(@product.price, precision: 0) %><span class="<%= @highlighted ? "text-sm font-medium text-purple-100" : "text-sm font-medium text-[#655d6f]" %>">+</span></p>
  <ul class="mt-6 grid gap-3 text-sm">
    <% @product.features.each do |feature| %>
      <li class="flex gap-3">
        <span class="<%= @highlighted ? "text-[#facc15]" : "cpt-check" %>" aria-hidden="true">✓</span>
        <span><%= feature %></span>
      </li>
    <% end %>
  </ul>
  <%= render Ui::ButtonComponent.new(label: @product.cta_label, href: new_quote_request_path(product_id: @product.id), variant: (@highlighted ? :light : :primary), class: "mt-8 w-full") %>
</article>
