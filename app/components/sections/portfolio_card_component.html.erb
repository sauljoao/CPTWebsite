<article class="cpt-card group flex h-full flex-col overflow-hidden p-0" data-controller="portfolio-card">
  <div class="<%= @accent[:surface] %> p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase <%= @accent[:ink] %>"><%= @project.product_type %></p>
        <h3 class="mt-3 text-xl font-semibold text-[#18111f]"><%= @project.title %></h3>
      </div>
      <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-[#655d6f]"><%= @project.industry %></span>
    </div>

    <div class="mt-6 grid grid-cols-3 gap-2 text-center text-xs font-semibold">
      <% @project.services.first(3).each do |service| %>
        <button class="rounded-lg bg-white/70 px-2 py-3 transition hover:bg-white" type="button" data-action="portfolio-card#spotlight" data-portfolio-card-label-param="<%= service %>">
          <%= service.split.first %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="cpt-body text-sm leading-6"><%= @project.summary %></p>

    <div class="mt-5 rounded-lg border border-[#e8dfef] p-4">
      <div class="flex items-center justify-between gap-4">
        <p class="text-sm font-semibold text-[#18111f]" data-portfolio-card-target="label">Resultado</p>
        <button class="rounded-full px-3 py-1 text-xs font-semibold text-white transition hover:opacity-85 <%= @accent[:button] %>" type="button" data-action="portfolio-card#toggle" data-portfolio-card-target="button">
          Pré-visualizar
        </button>
      </div>
      <p class="cpt-body mt-3 text-sm leading-6" data-portfolio-card-target="body"><%= @project.outcome %></p>
    </div>

    <div class="mt-5 hidden rounded-lg bg-[#f4edff] p-4" data-portfolio-card-target="details">
      <p class="text-xs font-semibold uppercase text-[#7c3aed]">Serviços</p>
      <ul class="mt-3 grid gap-2 text-sm text-[#655d6f]">
        <% @project.services.each do |service| %>
          <li><span class="cpt-check">✓</span> <%= service %></li>
        <% end %>
      </ul>
    </div>

    <%= link_to "Abrir estudo de caso", portfolio_project_path(@project), class: "cpt-link mt-6 inline-flex" %>
  </div>
</article>
