<footer class="border-t border-[#e8dfef] bg-white">
  <div class="cpt-container grid gap-8 py-12 text-sm text-[#655d6f] sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-semibold text-[#18111f]">CPT Consulting</p>
      <p class="mt-3 leading-6">Premium websites and digital systems for businesses that need clarity, speed, and trust.</p>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Company</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "About", about_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Portfolio", portfolio_path, class: "hover:text-[#18111f]" %>
        <%= link_to "FAQ", faq_path, class: "hover:text-[#18111f]" %>
      </div>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Services</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "Products", products_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Pricing", pricing_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Quote calculator", new_quote_request_path, class: "hover:text-[#18111f]" %>
      </div>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Start</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "Contact", contact_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Request meeting", contact_path(request_type: "meeting"), class: "hover:text-[#18111f]" %>
      </div>
    </div>
  </div>
</footer>
