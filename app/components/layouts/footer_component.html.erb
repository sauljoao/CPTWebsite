<footer class="border-t border-[#e8dfef] bg-white">
  <div class="cpt-container grid gap-8 py-12 text-sm text-[#655d6f] sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-semibold text-[#18111f]">CPT Consulting</p>
      <p class="mt-3 leading-6">Websites premium e sistemas digitais para empresas que precisam de clareza, rapidez e confiança.</p>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Empresa</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "Sobre", about_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Portefólio", portfolio_path, class: "hover:text-[#18111f]" %>
        <%= link_to "FAQ", faq_path, class: "hover:text-[#18111f]" %>
      </div>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Serviços</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "Produtos", products_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Preços", pricing_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Calculadora de orçamento", new_quote_request_path, class: "hover:text-[#18111f]" %>
      </div>
    </div>
    <div>
      <p class="font-semibold text-[#18111f]">Começar</p>
      <div class="mt-3 grid gap-2">
        <%= link_to "Contacto", contact_path, class: "hover:text-[#18111f]" %>
        <%= link_to "Pedir reunião", contact_path(request_type: "meeting"), class: "hover:text-[#18111f]" %>
      </div>
    </div>
  </div>
</footer>
